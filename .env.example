# GEMINI_API_KEY: Wajib untuk panggilan API Gemini AI
# Di Google AI Studio: Dikelola otomatis melalui panel Settings/Secrets.
# Di Vercel: Buka Vercel Project Dashboard -> Settings -> Environment Variables.
# Masukkan Name: GEMINI_API_KEY dan Value: (API Key Anda dari https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=

# APP_URL: URL tempat web di-hosting (opsional untuk Vercel, otomatis oleh AI Studio)
APP_URL=
